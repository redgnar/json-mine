{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "timeout": 10,
    "tmpDir": ".cache/infection",
    "logs": {
        "text": ".cache/infection/infection.log"
    },
    "mutators": {
        "@default": true,
        // The default error limit is an arbitrary safety cap — 99 vs 101 is behaviorally meaningless.
        "IncrementInteger": {
            "ignore": ["Ingot\\Schema\\OpisSchemaValidator::__construct"]
        },
        "DecrementInteger": {
            "ignore": ["Ingot\\Schema\\OpisSchemaValidator::__construct"]
        }
    },
    "minMsi": 90,
    "minCoveredMsi": 100
}
